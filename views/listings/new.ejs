<% layout("/layouts/boilerplate") %>
<body>
    <h3>Create a New Listing</h3>
    <form method="POST" action="/listings">
        <input name="listing[title]" placeholder="Enter title of listing" type="text">
        <br><br>
        <textarea name="listing[description]" placeholder="write decription"></textarea>
        <br><br>
        <input name="listing[image]" placeholder="enter image as URL/Link" type="text">
        <br><br>
        <input name="listing[price]" placeholder="Enter price" type="number">
        <br><br>
        <input name="listing[country]" placeholder="country" type="text">
        <br><br>
        <input name="listing[location]" placeholder="location" type="text">
        <br><br>
        <button>ADD</button>
    </form>
</body>
